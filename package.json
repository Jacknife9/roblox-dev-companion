{
  "name": "roblox-dev-companion",
  "version": "0.5.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --android --go",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build:web": "expo export --platform web",
    "build:mobile": "expo export --platform ios --platform android --output-dir dist-mobile",
    "server": "node --import tsx server/index.ts",
    "preview": "node scripts/serve-web.mjs",
    "build:plugin": "node --import tsx scripts/build-plugin.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.31",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/react": "~19.2.2",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "@playwright/test": "^1.56.0"
  },
  "engines": {
    "node": ">=24"
  }
}
