{
  "expo": {
    "name": "Roblox Dev Companion",
    "slug": "roblox-dev-companion",
    "version": "0.2.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.devcompanion",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.devcompanion"
    },
    "web": {
      "bundler": "metro",
      "name": "Dev Companion",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-font",
      "expo-secure-store"
    ]
  }
}
